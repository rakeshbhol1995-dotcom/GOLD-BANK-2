<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve static files directly if they exist in public or .next/static
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Proxy all other requests to Node.js server running on port 3000 (or default app port)
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
